rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSellerRole(role) {
      return role is string &&
        role in ['farmer', 'distributor', 'retailer'];
    }

    function isApprovedSeller(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return exists(userPath) &&
        isSellerRole(get(userPath).data.role);
    }

    function isActiveUser() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() &&
        exists(userPath) &&
        (!get(userPath).data.keys().hasAny(['status']) ||
          get(userPath).data.status != 'deactivated');
    }

    function isAdmin() {
      let adminPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() &&
        exists(adminPath) &&
        get(adminPath).data.role == 'admin' &&
        (!get(adminPath).data.keys().hasAny(['status']) ||
          get(adminPath).data.status != 'deactivated');
    }

    function isValidUserProfile(userId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'uid',
          'fullName',
          'email',
          'phone',
          'role',
          'emailVerified',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'fullName',
          'email',
          'phone',
          'role',
          'emailVerified',
          'createdAt'
        ]) &&
        data.uid == userId &&
        data.fullName is string &&
        data.fullName.size() > 0 &&
        data.fullName.size() <= 100 &&
        data.email is string &&
        data.email == request.auth.token.email &&
        data.phone is string &&
        data.phone.size() <= 30 &&
        data.role == 'user' &&
        (data.emailVerified == false ||
          (data.emailVerified == true &&
            request.auth.token.email_verified == true)) &&
        data.createdAt == request.time;
    }

    function isAddingDefaultRole() {
      let changes = request.resource.data.diff(resource.data);
      return !resource.data.keys().hasAny(['role']) &&
        changes.affectedKeys().hasOnly(['role']) &&
        changes.addedKeys().hasOnly(['role']) &&
        request.resource.data.role == 'user';
    }

    function isSellerApplicationApproval(userId) {
      let applicationPath = /databases/$(database)/documents/sellerApplications/$(userId);
      let application = getAfter(applicationPath).data;
      return existsAfter(applicationPath) &&
        application.uid == userId &&
        application.status == 'approved' &&
        application.requestedRole == request.resource.data.role &&
        application.businessName == request.resource.data.sellerName &&
        application.reviewedBy == request.auth.uid;
    }

    function isValidAdminUserUpdate(userId) {
      let changes = request.resource.data.diff(resource.data);
      return changes.affectedKeys().hasOnly([
          'fullName',
          'phone',
          'status',
          'role',
          'sellerName'
        ]) &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() > 0 &&
        request.resource.data.fullName.size() <= 100 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() <= 30 &&
        (!request.resource.data.keys().hasAny(['sellerName']) ||
          (request.resource.data.sellerName is string &&
            request.resource.data.sellerName.size() > 0 &&
            request.resource.data.sellerName.size() <= 100)) &&
        (!changes.affectedKeys().hasAny(['role', 'sellerName']) ||
          (isSellerRole(request.resource.data.role) &&
            isSellerApplicationApproval(userId))) &&
        (!request.resource.data.keys().hasAny(['status']) ||
          request.resource.data.status in ['active', 'deactivated']);
    }

    function isValidSellerApplication(userId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'uid',
          'fullName',
          'email',
          'phone',
          'requestedRole',
          'businessName',
          'businessDescription',
          'meetupLocation',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'fullName',
          'email',
          'phone',
          'requestedRole',
          'businessName',
          'businessDescription',
          'meetupLocation',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid == userId &&
        data.fullName is string &&
        data.fullName.size() > 0 &&
        data.fullName.size() <= 100 &&
        data.email == request.auth.token.email &&
        data.phone is string &&
        data.phone.size() > 0 &&
        data.phone.size() <= 30 &&
        isSellerRole(data.requestedRole) &&
        data.businessName is string &&
        data.businessName.size() > 0 &&
        data.businessName.size() <= 100 &&
        data.businessDescription is string &&
        data.businessDescription.size() > 0 &&
        data.businessDescription.size() <= 1000 &&
        data.meetupLocation is string &&
        data.meetupLocation.size() > 0 &&
        data.meetupLocation.size() <= 500 &&
        data.status == 'pending' &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    function isValidSellerApplicationReview() {
      let changes = request.resource.data.diff(resource.data);
      return resource.data.status == 'pending' &&
        changes.affectedKeys().hasOnly([
          'status',
          'reviewNote',
          'reviewedBy',
          'reviewedAt',
          'updatedAt'
        ]) &&
        request.resource.data.status in ['approved', 'rejected'] &&
        request.resource.data.reviewNote is string &&
        request.resource.data.reviewNote.size() <= 500 &&
        request.resource.data.reviewedBy == request.auth.uid &&
        request.resource.data.reviewedAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    function isValidSelfProfileUpdate() {
      let changes = request.resource.data.diff(resource.data);
      return changes.affectedKeys().hasOnly(['fullName', 'phone']) &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() > 0 &&
        request.resource.data.fullName.size() <= 100 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() <= 30;
    }

    function isValidProductCreate() {
      let data = request.resource.data;
      let sellerPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let seller = get(sellerPath).data;
      return data.keys().hasAll([
          'name',
          'description',
          'category',
          'price',
          'stock',
          'sellerId',
          'sellerName',
          'sellerEmail',
          'sellerMeetupLocation',
          'imageUrl',
          'imagePath',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name',
          'description',
          'category',
          'price',
          'stock',
          'sellerId',
          'sellerName',
          'sellerEmail',
          'sellerMeetupLocation',
          'imageUrl',
          'imagePath',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 100 &&
        data.description is string &&
        data.description.size() <= 1000 &&
        data.category is string &&
        data.category.size() > 0 &&
        data.category.size() <= 60 &&
        data.price is number &&
        data.price > 0 &&
        data.stock is int &&
        data.stock > 0 &&
        data.sellerId == request.auth.uid &&
        data.sellerName is string &&
        data.sellerName.size() > 0 &&
        data.sellerName.size() <= 100 &&
        data.sellerName ==
          (seller.keys().hasAny(['sellerName'])
            ? seller.sellerName
            : seller.fullName) &&
        data.sellerEmail is string &&
        data.sellerEmail.size() <= 254 &&
        data.sellerMeetupLocation is string &&
        data.sellerMeetupLocation.size() > 0 &&
        data.sellerMeetupLocation.size() <= 500 &&
        data.imageUrl is string &&
        data.imageUrl.size() > 0 &&
        data.imageUrl.size() <= 2048 &&
        data.imagePath is string &&
        data.imagePath.size() > 0 &&
        data.imagePath.size() <= 255 &&
        data.status == 'active' &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    function isValidSellerProductUpdate() {
      let changes = request.resource.data.diff(resource.data);
      return changes.affectedKeys().hasOnly([
          'name',
          'description',
          'category',
          'price',
          'stock',
          'sellerMeetupLocation',
          'imageUrl',
          'imagePath',
          'updatedAt'
        ]) &&
        request.resource.data.sellerId == resource.data.sellerId &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 1000 &&
        request.resource.data.category is string &&
        request.resource.data.category.size() > 0 &&
        request.resource.data.category.size() <= 60 &&
        request.resource.data.price is number &&
        request.resource.data.price > 0 &&
        request.resource.data.stock is int &&
        request.resource.data.stock >= 0 &&
        request.resource.data.sellerMeetupLocation is string &&
        request.resource.data.sellerMeetupLocation.size() > 0 &&
        request.resource.data.sellerMeetupLocation.size() <= 500 &&
        request.resource.data.imageUrl is string &&
        request.resource.data.imageUrl.size() <= 2048 &&
        request.resource.data.imagePath is string &&
        request.resource.data.imagePath.size() <= 255 &&
        request.resource.data.updatedAt == request.time;
    }

    function isBuyerStockReservation(productId) {
      let orderId = request.resource.data.lastOrderId;
      let orderPath = /databases/$(database)/documents/orders/$(orderId);
      let order = getAfter(orderPath).data;
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stock', 'updatedAt', 'lastOrderId']) &&
        request.resource.data.stock is int &&
        request.resource.data.stock >= 0 &&
        request.resource.data.stock < resource.data.stock &&
        request.resource.data.updatedAt == request.time &&
        orderId is string &&
        existsAfter(orderPath) &&
        order.productId == productId &&
        order.buyerId == request.auth.uid &&
        order.sellerId == resource.data.sellerId &&
        order.quantity == resource.data.stock - request.resource.data.stock &&
        order.status == 'pending';
    }

    function isBuyerStockRelease(productId) {
      let orderId = request.resource.data.lastRefundOrderId;
      let orderPath = /databases/$(database)/documents/orders/$(orderId);
      let oldOrder = get(orderPath).data;
      let order = getAfter(orderPath).data;
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stock', 'updatedAt', 'lastRefundOrderId']) &&
        request.resource.data.stock is int &&
        request.resource.data.stock > resource.data.stock &&
        request.resource.data.stock - resource.data.stock == oldOrder.quantity &&
        request.resource.data.updatedAt == request.time &&
        orderId is string &&
        existsAfter(orderPath) &&
        oldOrder.productId == productId &&
        oldOrder.status in ['pending', 'confirmed', 'ready_for_pickup'] &&
        order.status == 'cancelled' &&
        order.productId == productId &&
        (oldOrder.buyerId == request.auth.uid ||
          oldOrder.sellerId == request.auth.uid);
    }

    function isBuyerOrderEditStockChange(productId) {
      let orderId = request.resource.data.lastOrderId;
      let orderPath = /databases/$(database)/documents/orders/$(orderId);
      let oldOrder = get(orderPath).data;
      let order = getAfter(orderPath).data;
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stock', 'updatedAt', 'lastOrderId']) &&
        request.resource.data.stock is int &&
        request.resource.data.stock >= 0 &&
        request.resource.data.stock ==
          resource.data.stock + oldOrder.quantity - order.quantity &&
        request.resource.data.updatedAt == request.time &&
        orderId is string &&
        exists(orderPath) &&
        existsAfter(orderPath) &&
        oldOrder.buyerId == request.auth.uid &&
        oldOrder.productId == productId &&
        oldOrder.status in ['pending', 'confirmed'] &&
        order.buyerId == request.auth.uid &&
        order.productId == productId &&
        order.status == oldOrder.status &&
        order.quantity is int &&
        order.quantity > 0;
    }

    function isValidOrderCreate(orderId) {
      let data = request.resource.data;
      let productPath = /databases/$(database)/documents/products/$(data.productId);
      let product = get(productPath).data;
      let productAfter = getAfter(productPath).data;
      return data.keys().hasAll([
          'buyerId',
          'buyerName',
          'buyerEmail',
          'contactNumber',
          'buyerMeetupLocation',
          'deliveryMethod',
          'orderNotes',
          'sellerId',
          'sellerName',
          'sellerEmail',
          'sellerMeetupLocation',
          'productId',
          'productName',
          'productImageUrl',
          'quantity',
          'unitPrice',
          'total',
          'scheduledAt',
          'status',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'buyerId',
          'buyerName',
          'buyerEmail',
          'contactNumber',
          'buyerMeetupLocation',
          'deliveryMethod',
          'orderNotes',
          'sellerId',
          'sellerName',
          'sellerEmail',
          'sellerMeetupLocation',
          'productId',
          'productName',
          'productImageUrl',
          'locationLatitude',
          'locationLongitude',
          'quantity',
          'unitPrice',
          'total',
          'scheduledAt',
          'status',
          'createdAt'
        ]) &&
        data.buyerId == request.auth.uid &&
        data.buyerName == get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.fullName &&
        data.buyerEmail == request.auth.token.email &&
        data.contactNumber is string &&
        data.contactNumber.size() > 0 &&
        data.contactNumber.size() <= 30 &&
        data.buyerMeetupLocation is string &&
        data.buyerMeetupLocation.size() <= 500 &&
        data.deliveryMethod in ['meetup_pickup', 'pickup', 'meetup'] &&
        (data.deliveryMethod != 'meetup' ||
          (data.buyerMeetupLocation.size() > 0 &&
            data.keys().hasAll([
              'locationLatitude',
              'locationLongitude'
            ]) &&
            data.locationLatitude is number &&
            data.locationLatitude >= -90 &&
            data.locationLatitude <= 90 &&
            data.locationLongitude is number &&
            data.locationLongitude >= -180 &&
            data.locationLongitude <= 180)) &&
        (data.keys().hasAny([
            'locationLatitude',
            'locationLongitude'
          ])
          ? (data.keys().hasAll([
                'locationLatitude',
                'locationLongitude'
              ]) &&
              data.locationLatitude is number &&
              data.locationLatitude >= -90 &&
              data.locationLatitude <= 90 &&
              data.locationLongitude is number &&
              data.locationLongitude >= -180 &&
              data.locationLongitude <= 180)
          : true) &&
        data.orderNotes is string &&
        data.orderNotes.size() <= 500 &&
        data.scheduledAt is timestamp &&
        data.sellerId == product.sellerId &&
        data.sellerId != request.auth.uid &&
        data.sellerName == product.sellerName &&
        data.sellerEmail == product.sellerEmail &&
        data.sellerMeetupLocation == product.sellerMeetupLocation &&
        data.sellerMeetupLocation.size() > 0 &&
        data.productName == product.name &&
        (!data.keys().hasAny(['productImageUrl']) ||
          (data.productImageUrl is string &&
            data.productImageUrl == product.imageUrl)) &&
        product.status == 'active' &&
        data.quantity is int &&
        data.quantity > 0 &&
        data.quantity <= product.stock &&
        data.unitPrice == product.price &&
        data.total == data.unitPrice * data.quantity &&
        data.status == 'pending' &&
        data.createdAt == request.time &&
        productAfter.stock == product.stock - data.quantity &&
        productAfter.lastOrderId == orderId;
    }

    function isValidOrderStatusUpdate(orderId) {
      let changes = request.resource.data.diff(resource.data);
      let nextStatus = request.resource.data.status;
      let productPath = /databases/$(database)/documents/products/$(resource.data.productId);
      return changes.affectedKeys().hasOnly(['status']) &&
        nextStatus in [
          'pending',
          'confirmed',
          'ready_for_pickup',
          'picked_up',
          'completed',
          'cancelled'
        ] &&
        (nextStatus != 'cancelled' ||
          (getAfter(productPath).data.stock ==
              get(productPath).data.stock + resource.data.quantity &&
            getAfter(productPath).data.lastRefundOrderId == orderId)) &&
        (
          (isAdmin()) ||
          (resource.data.buyerId == request.auth.uid &&
            resource.data.status in ['pending', 'confirmed', 'ready_for_pickup'] &&
            nextStatus == 'cancelled') ||
          (resource.data.sellerId == request.auth.uid &&
            ((resource.data.status == 'pending' &&
                nextStatus in ['confirmed', 'ready_for_pickup', 'cancelled']) ||
              (resource.data.status == 'confirmed' &&
                nextStatus in ['ready_for_pickup', 'completed', 'cancelled']) ||
              (resource.data.status == 'ready_for_pickup' &&
                nextStatus in ['picked_up', 'cancelled'])))
        );
    }

    function isValidBuyerOrderEdit(orderId) {
      let changes = request.resource.data.diff(resource.data);
      let productPath = /databases/$(database)/documents/products/$(resource.data.productId);
      let product = get(productPath).data;
      let productAfter = getAfter(productPath).data;
      return changes.affectedKeys().hasOnly([
          'quantity',
          'total',
          'contactNumber',
          'buyerMeetupLocation',
          'orderNotes'
        ]) &&
        resource.data.buyerId == request.auth.uid &&
        resource.data.status in ['pending', 'confirmed'] &&
        request.resource.data.buyerId == resource.data.buyerId &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.productId == resource.data.productId &&
        request.resource.data.unitPrice == resource.data.unitPrice &&
        request.resource.data.quantity is int &&
        request.resource.data.quantity > 0 &&
        request.resource.data.quantity <= product.stock + resource.data.quantity &&
        request.resource.data.total ==
          request.resource.data.unitPrice * request.resource.data.quantity &&
        request.resource.data.contactNumber is string &&
        request.resource.data.contactNumber.size() > 0 &&
        request.resource.data.contactNumber.size() <= 30 &&
        request.resource.data.buyerMeetupLocation is string &&
        request.resource.data.buyerMeetupLocation.size() <= 500 &&
        request.resource.data.orderNotes is string &&
        request.resource.data.orderNotes.size() <= 500 &&
        productAfter.stock ==
          product.stock + resource.data.quantity - request.resource.data.quantity &&
        (request.resource.data.quantity == resource.data.quantity ||
          productAfter.lastOrderId == orderId);
    }

    match /users/{userId} {
      allow create: if isOwner(userId) && isValidUserProfile(userId);
      allow get: if isOwner(userId);
      allow list: if isAdmin();
      allow update: if (isOwner(userId) &&
          (isAddingDefaultRole() || isValidSelfProfileUpdate())) ||
        (isAdmin() && isValidAdminUserUpdate(userId));
      allow delete: if false;
    }

    match /sellerApplications/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) &&
        isActiveUser() &&
        get(/databases/$(database)/documents/users/$(userId)).data.role
          in ['user', 'consumer'] &&
        isValidSellerApplication(userId);
      allow update: if (isOwner(userId) &&
          resource.data.status == 'rejected' &&
          isValidSellerApplication(userId)) ||
        (isAdmin() && isValidSellerApplicationReview());
      allow delete: if false;
    }

    match /products/{productId} {
      allow get, list: if isAdmin() ||
        (isActiveUser() &&
          (resource.data.status == 'active' ||
            resource.data.sellerId == request.auth.uid));
      allow create: if isActiveUser() &&
        isApprovedSeller(request.auth.uid) &&
        isValidProductCreate();
      allow update: if isAdmin() ||
        (
          isActiveUser() &&
          (
            (
              resource.data.sellerId == request.auth.uid &&
              isValidSellerProductUpdate()
            ) ||
            isBuyerStockReservation(productId) ||
            isBuyerStockRelease(productId) ||
            isBuyerOrderEditStockChange(productId)
          )
        );
      allow delete: if isAdmin() ||
        (isActiveUser() && resource.data.sellerId == request.auth.uid);
    }

    match /orders/{orderId} {
      allow get, list: if isAdmin() ||
        (isActiveUser() &&
          (resource.data.buyerId == request.auth.uid ||
            resource.data.sellerId == request.auth.uid));
      allow create: if isActiveUser() && isValidOrderCreate(orderId);
      allow update: if isActiveUser() &&
        (isValidOrderStatusUpdate(orderId) || isValidBuyerOrderEdit(orderId));
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if isActiveUser() || isAdmin();
      allow write: if isAdmin();
    }

  }
}
